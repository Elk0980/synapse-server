# Synapse Business — единый вход.
# Сертификаты выпускаются автоматически при первом обращении к домену.
# Новый клиент = новый блок ниже + папка в sites/. Больше ничего не нужно.

{
  email admin@synapsebusiness.ru
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(static) {
  encode zstd gzip
  file_server
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

(draft) {
  header X-Robots-Tag "noindex, nofollow"
}

# --- Панель черновиков: все сайты в одном месте -----------------------------
panel.synapsebusiness.ru {
  root * /srv/panel
  import /data/auth/*.conf
  import draft
  import static
}

# --- Корневой домен: пока ведёт на панель -----------------------------------
synapsebusiness.ru, www.synapsebusiness.ru {
  root * /srv/panel
  import static
}

# --- Клиент: Авокадо (студия дизайна тела, Иркутск) -------------------------
avokado.synapsebusiness.ru {
  root * /srv/sites/avokado
  @price {
    path /api/price
    method GET
  }
  handle @price {
    rewrite * /content/avokado/price
    reverse_proxy content:8080
  }
  @site {
    path /api/site
    method GET
  }
  handle @site {
    rewrite * /content/avokado/site
    reverse_proxy content:8080
  }
  @assets {
    path /api/assets/*
    method GET
  }
  handle @assets {
    uri replace /api/assets/ /content/avokado/assets/
    reverse_proxy content:8080
  }
  @sitedata path /data/*
  header @sitedata Access-Control-Allow-Origin https://synapse.synapsebusiness.ru
  import static
}

# Место под второй вариант сайта Авокадо.
avokado-v2.synapsebusiness.ru {
  root * /srv/sites/avokado-v2
  import draft
  import static
}

# --- Клиент: ALVI (SPA, Иркутск) --------------------------------------------
alvi.synapsebusiness.ru {
  root * /srv/sites/alvi
  # Прайс и витрины главной берутся из сервиса content (только чтение).
  @price {
    path /api/price
    method GET
  }
  handle @price {
    rewrite * /content/alvi/price
    reverse_proxy content:8080
  }
  # Тексты и фоны главной (только чтение) и загруженные в кабинете картинки.
  @site {
    path /api/site
    method GET
  }
  handle @site {
    rewrite * /content/alvi/site
    reverse_proxy content:8080
  }
  @assets {
    path /api/assets/*
    method GET
  }
  handle @assets {
    uri replace /api/assets/ /content/alvi/assets/
    reverse_proxy content:8080
  }
  # Редактор в кабинете читает исходные тексты блоков (data/site.json) с этого домена.
  @sitedata path /data/*
  header @sitedata Access-Control-Allow-Origin https://synapse.synapsebusiness.ru
  import draft
  import static
  handle_errors {
    @not_found expression {http.error.status_code} == 404
    rewrite @not_found /404.html
    file_server
  }
}

# --- Synapse Business: сайт-презентация -------------------------------------
synapse.synapsebusiness.ru {
  root * /srv/sites/synapse
  # cabinet.html uses same-origin /dashboard and /leads requests for CRM.
  # CRM теперь сам проверяет X-API-Key и без него отвечает 401.
  @crm path /dashboard /leads /leads/*
  reverse_proxy @crm crm:8080
  # Редактор прайса (price-editor.html) ходит в сервис content по тому же домену.
  @content path /content/*
  reverse_proxy @content content:8080
  import draft
  import static
}

# --- TaiSabai: прототип воронки «Переезд» -----------------------------------
taisabai.synapsebusiness.ru {
  root * /srv/sites/taisabai
  import draft
  import static
}

# --- Доска задач агентов ----------------------------------------------------
board.synapsebusiness.ru {
  root * /srv/sites/board
  import draft
  import static
}

# --- Чат -------------------------------------------------------------------
chat.synapsebusiness.ru {
  root * /srv/sites/chat
  @chat_api path /conversations /conversations/*
  reverse_proxy @chat_api chat:8080
  import draft
  import static
}

# --- Palitra Love: магазин цветов и воздушных шаров (черновик) -------------
palitra-love.synapsebusiness.ru {
  root * /srv/sites/palitra-love
  import draft
  try_files {path} {path}/index.html /index.html
  import static
}
