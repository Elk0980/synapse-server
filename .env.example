# Настоящий файл .env создаётся на сервере вручную и никогда не коммитится.

# Секретный API-ключ CRM.
CRM_API_KEY=

# Разрешённые источники CORS для CRM (пустое значение отключает список).
CRM_ALLOWED_ORIGINS=

# Ограничение частоты запросов к CRM: окно в миллисекундах и максимум запросов с IP.
CRM_RATE_LIMIT_WINDOW_MS=60000
CRM_RATE_LIMIT_MAX=60

# Секретный API-ключ сервиса чата.
CHAT_API_KEY=

# Разрешённые источники CORS для чата (пустое значение отключает список).
CHAT_ALLOWED_ORIGINS=

# Секретный ключ сервиса контента (редактор прайса в кабинете). Создаётся synapse-sync автоматически.
CONTENT_API_KEY=

# Второй ключ сервиса контента — для редактора со стороны клиента (Татьяна). Создаётся synapse-sync автоматически.
CONTENT_EDITOR_KEY=

# Разрешённые источники CORS для сервиса контента (пустое значение отключает список).
CONTENT_ALLOWED_ORIGINS=

# Необязательный URL API модели для чата.
MODEL_API_URL=

# Необязательный API-ключ модели для чата.
MODEL_API_KEY=
