# Настоящий файл .env создаётся на сервере вручную и никогда не коммитится.

# Секретный API-ключ CRM.
CRM_API_KEY=

# Разрешённые источники CORS для CRM (пустое значение отключает список).
CRM_ALLOWED_ORIGINS=

# Секретный API-ключ сервиса чата.
CHAT_API_KEY=

# Разрешённые источники CORS для чата. При пустом значении разрешён только same-origin.
CHAT_ALLOWED_ORIGINS=

# Ключ интерфейса владельца чатов. Создаётся synapse-sync автоматически.
CHAT_ADMIN_KEY=

# Настройки Telegram-моста. Токен и id владельца задаются вручную, секрет создаётся автоматически.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=

# Выход чата в Telegram по IPv6. Это два операционных переключателя, а не учётные данные:
# они не дают никаких новых прав и ничего не открывают наружу. По умолчанию выключено,
# поведение прежнее. Включать только там, где api.telegram.org отвечает по IPv6, а по IPv4
# не отвечает; порядок и последствия описаны в ops/chat/README.md. Значение первой переменной
# задаётся ровно как true или false, кавычки во второй не нужны.
CHAT_IPV6_ENABLED=false
CHAT_NODE_OPTIONS=

# HMAC-секрет ссылок клиентской доски (длинная случайная строка).
CLIENT_BOARD_SECRET=
# Шаблон публичного URL доски; {company} заменяется кодом компании.
CLIENT_BOARD_BASE_URL=https://{company}.synapsebusiness.ru/zadachi.html

# Локальный обработчик ответов Хью на компьютере владельца. Сервер хранит только hex SHA256
# отдельного случайного ключа (сам ключ лежит на компьютере вне Git); компании из списка
# обслуживаются только этим путём, даже когда компьютер выключен. Пустые значения — прежнее
# поведение через hugh-runtime. Хеш: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <ключ>
HUGH_LOCAL_WORKER_KEY_SHA256=
HUGH_LOCAL_WORKER_COMPANIES=
# Резерв ответов Хью (OpenAI-совместимые chat/completions). Пустые значения = резерв выключен.
# Наличие переменных не подтверждает живое подключение: живой ответ виден в статусе чата.
HUGH_FALLBACK_PROVIDERS=
HUGH_FALLBACK_OPENROUTER_URL=
HUGH_FALLBACK_OPENROUTER_KEY=
HUGH_FALLBACK_OPENROUTER_MODEL=
HUGH_FALLBACK_DEEPSEEK_URL=
HUGH_FALLBACK_DEEPSEEK_KEY=
HUGH_FALLBACK_DEEPSEEK_MODEL=
# Через сколько минут офлайна компьютера владельца сервер отвечает за компании локального обработчика резервом (0 — никогда).
HUGH_FALLBACK_LOCAL_OFFLINE_MINUTES=0
# Честное подтверждение приёма, когда ни один путь ответа не доступен (включается автоматически вместе с резервом).
HUGH_ACK_WHEN_UNAVAILABLE=0
# Мастер-ключ шифрования ключей провайдеров, которые владелец вводит в ЛК.
# Минимум 32 символа, задаётся только в защищённом окружении сервера, не в репозитории.
# Пусто = хранилище закрыто: ключи нельзя ни сохранить, ни прочитать (fail-closed).
HUGH_PROVIDER_MASTER_KEY=
# Дополнительные разрешённые хосты API через запятую. Пусто = только официальные из каталога.
# Произвольный адрес из ЛК задать нельзя ни при каком значении.
HUGH_PROVIDER_ALLOWED_HOSTS=
# Бюджетный стоп резервных провайдеров. Пусто = границы нет и расход ничем не ограничен.
# Достигнув границы, сервис перестаёт обращаться к платным API: вопрос остаётся в очереди,
# приём подтверждается честно и заводится задача менеджеру. Оплату код не производит.
HUGH_FALLBACK_BUDGET_USD=
HUGH_FALLBACK_BUDGET_MAX_REQUESTS=
HUGH_FALLBACK_BUDGET_WINDOW_DAYS=30
# Жёсткий потолок ответа: под него бронируются деньги, он же уходит провайдеру в max_tokens.
HUGH_FALLBACK_BUDGET_MAX_OUTPUT_TOKENS=1200
# Цены объявляет владелец: без них расход в долларах по провайдеру не считается
# и работает только граница по числу обращений. Значения по умолчанию не подставляются.
HUGH_FALLBACK_OPENROUTER_USD_PER_1K_PROMPT=
HUGH_FALLBACK_OPENROUTER_USD_PER_1K_COMPLETION=
HUGH_FALLBACK_DEEPSEEK_USD_PER_1K_PROMPT=
HUGH_FALLBACK_DEEPSEEK_USD_PER_1K_COMPLETION=

# Telegram Mini App чата проекта: числовой ID бота @synapse_sb_bot (часть токена до двоеточия; не секрет).
# Нужен только для проверки подписи Telegram открытым ключом. Пустое значение честно отключает вход из Telegram.
TELEGRAM_BOT_ID=
# Имя бота без @ (не секрет): нужно для @упоминаний Хью в группах и команд /plan@бот.
TELEGRAM_BOT_USERNAME=
# Публичный адрес кабинета для подсказки /content.
CABINET_PUBLIC_URL=

# Секретный ключ сервиса контента (редактор прайса в кабинете). Создаётся synapse-sync автоматически.
CONTENT_API_KEY=

# Второй ключ сервиса контента — для редактора со стороны клиента (Татьяна). Создаётся synapse-sync автоматически.
CONTENT_EDITOR_KEY=

# Разрешённые источники CORS для сервиса контента (пустое значение отключает список).
CONTENT_ALLOWED_ORIGINS=

# Необязательный URL API модели для чата.
MODEL_API_URL=

# Необязательный API-ключ модели для чата.
MODEL_API_KEY=

# Окно и максимальное число запросов для ограничения частоты CRM.
CRM_RATE_LIMIT_WINDOW_MS=
CRM_RATE_LIMIT_MAX=

# SMTP-уведомления о заявках. Без пользователя/пароля заявки ожидают в очереди CRM.
# Для ALVI и АВОКАДО обязательны отдельные адреса; общий адрес их не заменяет.
LEADS_SMTP_HOST=smtp.yandex.ru
LEADS_SMTP_PORT=465
LEADS_SMTP_USER=
LEADS_SMTP_PASSWORD=
LEADS_MAIL_FROM=
LEADS_NOTIFY_EMAIL=
LEADS_NOTIFY_EMAIL_ALVI=
LEADS_NOTIFY_EMAIL_AVOKADO=Avocado38@bk.ru

# Единый вход в кабинет: записи login:role:scrypt-hash через точку с запятой и секрет подписи cookie.
AUTH_USERS=
SESSION_SECRET=
