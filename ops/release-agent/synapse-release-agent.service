[Unit]
Description=Synapse managed release worker
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/synapse/release-agent/accepted-config.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/synapse-release-agent/agent.py --config /etc/synapse/release-agent/accepted-config.json
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/synapse /opt/synapse-release-agent /var/lib/synapse-release-agent /etc/synapse/release-agent
StandardOutput=journal
StandardError=null
