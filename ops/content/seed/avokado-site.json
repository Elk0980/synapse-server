    {
      "id": "pain",
      "title": "Сколько раз вы мечтали…",
      "fields": [
        {
          "key": "pain.rv-1",
          "label": "Заголовок",
          "value": "Сколько раз вы мечтали об идеальном теле?",
          "multiline": false
        },
        {
          "key": "pain.p-1",
          "label": "Текст",
          "value": "Сколько раз вы обещали себе начать «с понедельника»?",
          "multiline": false
        },
        {
          "key": "pain.p-2",
          "label": "Текст",
          "value": "Сколько диет закончились срывом — и плюс два кило сверху?",
          "multiline": false
        },
        {
          "key": "pain.p-3",
          "label": "Текст",
          "value": "Изнурительные тренировки, брошенные через неделю?",
          "multiline": false
        },
        {
          "key": "pain.p-4",
          "label": "Текст",
          "value": "Платье, которое ждёт, «когда похудею»?",
          "multiline": false
        },
        {
          "key": "pain.p-5",
          "label": "Текст",
          "value": "Фото, где вы себя не узнаёте?",
          "multiline": false
        },
        {
          "key": "pain.p-6",
          "label": "Текст",
          "value": "Лето, к которому опять «не успела»?",
          "multiline": false
        },
        {
          "key": "pain.p-7",
          "label": "Текст",
          "value": "<b>60 дней</b> запретов и приседаний через силу — и сантиметр показывает почти то же самое",
          "multiline": false
        },
        {
          "key": "pain.verdict-1",
          "label": "Текст",
          "value": "Поэтому я нашла вариант — <b>легче</b>.",
          "multiline": false
        },
        {
          "key": "pain.quote-1",
          "label": "Цитата героини",
          "value": "«Я, как и каждая девушка, мечтаю быть красивой, уверенной, с идеальной фигурой. Но в нынешнем темпе жизни <em>не получается держаться</em> диет, тренировок и прочих «очевидных» вещей.",
          "multiline": true
        }
      ],
      "background": {
        "default": "",
        "image": null,
        "opacity": null
      }
    },
