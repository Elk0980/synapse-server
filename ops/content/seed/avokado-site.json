          "multiline": false
        },
        {
          "key": "method-1.b-1",
          "label": "Акцент",
          "value": "Вакуумно-роликовый массаж",
          "multiline": false
        },
        {
          "key": "method-1.b-2",
          "label": "Акцент",
          "value": "Кавитация и RF-лифтинг",
          "multiline": false
        },
        {
          "key": "method-1.b-3",
