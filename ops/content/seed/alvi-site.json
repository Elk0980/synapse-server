   "fields": [
    {
     "key": "faq.content-title-1",
     "label": "Заголовок",
     "value": "Частые вопросы",
     "multiline": false
    },
    {
     "key": "faq.summary-1",
     "label": "Вопрос",
     "value": "Сколько стоит массаж в Иркутске в ALVI?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-1",
     "label": "Текст",
     "value": "Расслабляющий массаж и массаж спины — 2 800 ₽, парный массаж — от 5 600 ₽. SPA-программы: «Релакс» — 3 500 ₽, «Душевное расслабление» — 5 600 ₽, «Ароматное погружение» — 6 300 ₽. Программы для двоих — 6 900–17 600 ₽.",
     "multiline": true
    },
    {
     "key": "faq.summary-2",
     "label": "Вопрос",
     "value": "Как записаться?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-2",
     "label": "Текст",
     "value": "Через Telegram — отвечаем в течение 2 минут. Работаем ежедневно с 09:00 до 22:00 по предварительной записи.",
     "multiline": true
    },
    {
     "key": "faq.summary-3",
     "label": "Вопрос",
     "value": "Где вы находитесь?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-3",
     "label": "Текст",
     "value": "Иркутск, Депутатская улица, 71а, Октябрьский район.",
     "multiline": false
    },
    {
     "key": "faq.summary-4",
     "label": "Вопрос",
     "value": "Как оформить подарочный сертификат?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-4",
     "label": "Текст",
     "value": "Напишите в Telegram: сертификат бывает электронный (приходит в мессенджер) или бумажный в конверте с лентой. Оформляется на любую сумму или конкретную программу, доставка по Иркутску бесплатная.",
     "multiline": true
    },
    {
     "key": "faq.summary-5",
     "label": "Вопрос",
     "value": "Есть ли противопоказания?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-5",
     "label": "Текст",
     "value": "Да, к массажу и SPA-процедурам есть противопоказания — проконсультируйтесь со специалистом. При записи расскажите о самочувствии и хронических заболеваниях, мастер подберёт подходящую программу.",
     "multiline": true
    },
    {
     "key": "faq.summary-6",
     "label": "Вопрос",
     "value": "Принимаете ли мужчин?",
     "multiline": false
    },
    {
     "key": "faq.faq-answer-6",
     "label": "Текст",
     "value": "Да, программы и массаж — для женщин и мужчин.",
     "multiline": false
    }
   ],
