#!/bin/sh
set -eu

REPO_DIR=${SYNAPSE_REPO_DIR:-/opt/synapse}
BRANCH=${SYNAPSE_BRANCH:-main}
ENV_FILE=${SYNAPSE_ENV_FILE:-$REPO_DIR/.env}

cd "$REPO_DIR"

# Отметка последней успешной выкладки. Она лежит в служебном каталоге git: не входит
# в рабочую копию, не публикуется и не переживает переустановку репозитория.
MARKER=''

# The EXIT trap gives every invocation one concise deployment-state marker, even
# when fetch, build, or startup fails. It intentionally prints no environment.
report_state() {
  status=$?
  commit=$(git rev-parse --short=12 HEAD 2>/dev/null || printf '%s' unknown)
  deployed=none
  if [ -n "$MARKER" ] && [ -f "$MARKER" ]; then
    deployed=$(cut -c1-12 "$MARKER" 2>/dev/null | head -n 1 || printf '%s' unknown)
    [ -n "$deployed" ] || deployed=none
  fi
  running=$(docker compose ps --status running -q 2>/dev/null | awk 'NF { count++ } END { print count+0 }')
  printf 'synapse-sync commit=%s deployed=%s running=%s status=%s\n' "$commit" "$deployed" "$running" "$status"
  # Код возврата не теряется в отчёте: таймер и journalctl должны видеть неудачу.
  exit "$status"
}
trap report_state EXIT

MARKER="$(git rev-parse --git-dir)/synapse-sync-deployed"

config_hash() {
  if [ -f caddy/Caddyfile ]; then
    sha256sum caddy/Caddyfile | awk '{print $1}'
  else
    printf '%s\n' missing
  fi
}

has_value() {
  key=$1
  [ -f "$ENV_FILE" ] && awk -F= -v key="$key" '
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      if (value != "") found = 1
    }
    END { exit !found }
  ' "$ENV_FILE"
}

ensure_secret() {
  key=$1
  has_value "$key" && return 0

  # openssl produces a fresh value; there is deliberately no fallback/default.
  value=$(openssl rand -hex 32)
  printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
}

# Create only absent required values. Existing non-empty values are never
# rewritten, which keeps chat and CRM paired across all subsequent runs.
#
# Ограничение umask действует ТОЛЬКО на создание файла с секретами: между созданием и
# chmod иначе оставалось бы окно, когда .env читаем посторонним. Ниже маска
# восстанавливается, потому что под umask 077 git создавал бы рабочую копию с файлами
# 0600 и каталогами 0700, COPY уносил бы эти права в образы, и непривилегированный
# пользователь в контейнере не смог бы прочитать даже /app/package.json.
previous_umask=$(umask)
umask 077
if [ ! -e "$ENV_FILE" ]; then
  : > "$ENV_FILE"
fi
chmod 600 "$ENV_FILE"
ensure_secret CRM_API_KEY
ensure_secret CHAT_API_KEY
ensure_secret CHAT_ADMIN_KEY
ensure_secret TELEGRAM_WEBHOOK_SECRET
ensure_secret CONTENT_API_KEY
ensure_secret CONTENT_EDITOR_KEY
ensure_secret SESSION_SECRET
umask "$previous_umask"

deployed_commit=''
deployed_caddy=''
if [ -f "$MARKER" ]; then
  read -r deployed_commit deployed_caddy < "$MARKER" || true
fi

git fetch --quiet origin "$BRANCH"
git reset --hard --quiet "origin/$BRANCH"
desired=$(git rev-parse HEAD)
desired_caddy=$(config_hash)

# Сравнивается не прежний HEAD, а отметка последней успешной выкладки: рабочая копия
# переходит на нужный коммит до сборки, поэтому сорванная сборка иначе выглядела бы
# как «ничего не изменилось» и образы остались бы старыми навсегда.
# Отметки нет — собираем один раз.
if [ "$deployed_commit" = "$desired" ]; then
  # Reconcile stopped/exited services without spending time on an unnecessary build.
  docker compose up -d --no-build
else
  # Compose rebuilds changed build contexts and also creates newly added services.
  docker compose up -d --build
fi

# Конфигурация Caddy тоже сверяется с выложенным состоянием, а не с изменением файла
# в этом запуске: после неудачи перезагрузка повторяется, пока не пройдёт.
if [ "$deployed_caddy" != "$desired_caddy" ]; then
  if ! docker compose exec -T caddy \
    caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile; then
    docker compose restart caddy
  fi
fi

# Отметка двигается только здесь: любая ошибка выше оставляет её прежней, и следующий
# запуск таймера снова идёт со сборкой, хотя git уже на нужном коммите.
# Права отметки задаются явно, а не через umask: она остаётся приватной независимо от
# того, с какой маской запущен таймер.
printf '%s %s\n' "$desired" "$desired_caddy" > "$MARKER.tmp"
chmod 600 "$MARKER.tmp"
mv "$MARKER.tmp" "$MARKER"
